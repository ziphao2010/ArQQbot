{
  "name": "arqqbot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "ArQQbot contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziphao2010/ArQQbot.git"
  },
  "homepage": "https://github.com/ziphao2010/ArQQbot#readme",
  "bugs": {
    "url": "https://github.com/ziphao2010/ArQQbot/issues"
  },
  "keywords": [
    "arqqbot",
    "qq-bot",
    "cordis",
    "electron",
    "plugin"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm --filter arqqbot-plugin-echo build && pnpm --filter @arqqbot/runtime build && pnpm --filter @arqqbot/desktop build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "package:win": "pnpm build && pnpm --filter @arqqbot/desktop exec electron-builder --win nsis"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
